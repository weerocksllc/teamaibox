+typedef struct raop_conn_s raop_conn_t;
+
+#ifdef TEAMAIBOX_PIN_STDIN
+#include <pthread.h>
+static pthread_mutex_t teamaibox_source_mutex = PTHREAD_MUTEX_INITIALIZER;
+static unsigned teamaibox_source_count = 0;
+/* Fixed lifecycle telemetry only: no peer identifiers or user content. A
+ * metadata/auth-only connection closing must not stop a different stream. */
+static void teamaibox_source_state(raop_conn_t *conn, bool active) {
+    pthread_mutex_lock(&teamaibox_source_mutex);
+    if (conn->teamaibox_mirroring != active) {
+        conn->teamaibox_mirroring = active;
+        if (active) ++teamaibox_source_count;
+        else if (teamaibox_source_count) --teamaibox_source_count;
+        fputs(teamaibox_source_count ? "TBS1 1\n" : "TBS1 0\n", stderr);
+        fflush(stderr);
+    }
+    pthread_mutex_unlock(&teamaibox_source_mutex);
+}
+#endif
+
+#include "raop_handlers.h"
