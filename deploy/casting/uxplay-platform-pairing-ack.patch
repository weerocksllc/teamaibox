 #include "teamaibox_pairing_budget.h"
 #include "teamaibox_paired_peer.h"
+#include "teamaibox_platform_pairing_ack.h"
 static teamaibox_pairing_budget_t teamaibox_pairing_budget =
     TEAMAIBOX_PAIRING_BUDGET_INITIALIZER;
+static pthread_mutex_t teamaibox_platform_pair_mutex = PTHREAD_MUTEX_INITIALIZER;
+static bool teamaibox_confirm_platform_pairing(const unsigned char key[32]) {
+    if (pthread_mutex_lock(&teamaibox_platform_pair_mutex) != 0) return false;
+    /* Descriptor 3 is an anonymous, dedicated supervisor socketpair. A
+     * missing supervisor or rejected/expired Platform session fails closed. */
+    bool accepted = teamaibox_platform_pairing_ack(3, key);
+    pthread_mutex_unlock(&teamaibox_platform_pair_mutex);
+    return accepted;
+}
