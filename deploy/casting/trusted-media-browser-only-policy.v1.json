{
  "schemaVersion": 1,
  "policyId": "teamaibox.trusted-media-browser-only.v1",
  "status": "candidate-not-deployed",
  "supportedOutputs": ["browser"],
  "container": {
    "user": "65532:65532",
    "readOnlyRootFilesystem": true,
    "privileged": false,
    "capDrop": ["ALL"],
    "capAdd": [],
    "noNewPrivileges": true,
    "directDevices": [],
    "deviceRequests": [],
    "containerRuntime": "runc",
    "nvidiaVisibleDevices": "void",
    "displaySocketMounted": false,
    "hostDbusMounted": false,
    "dockerSocketMounted": false,
    "localAudioMounted": false,
    "displayLeaseMounted": false,
    "persistentWritableMounts": [],
    "logDriver": "none",
    "networkException": "exact-main-LAN-interface-for-session-scoped-discovery-and-encrypted-media",
    "credentialDelivery": "exact-private-read-only-tmpfs-directory",
    "mediaState": "memory-and-bounded-tmpfs-only"
  },
  "codecMode": "existing-software-h264-decode-vp8-opus-browser-publisher",
  "maximumSources": 1,
  "maximumBrowserViewers": null,
  "concurrencyAcceptanceViewers": [1, 8],
  "publisherEncodeRenditions": 1,
  "physicalDisplayReservations": 0,
  "localAudioReservations": 0,
  "gnomeManagedByCasting": false,
  "sharedNvidiaDriverChangesAllowed": false,
  "kernelGpuResetAllowed": false,
  "coreServiceReserveGiB": 32,
  "hostMarginGiB": 16,
  "automaticOfficeModelDrainAllowed": false,
  "recordingAllowed": false,
  "accepted": false
}
