# Copy to an owner-only local installation file. No IP or UUID is baked into images.
# Keep the existing appliance UUID when updating; never generate one per restart.
PLATFORM_APPLIANCE_NODE_ID=
# Must match DNS/SAN on the local Agent and gateway certificates.
PLATFORM_APPLIANCE_NODE_KEY=localhost
# Legacy-only fallback. Single-appliance deployments read the host's live address file.
PLATFORM_APPLIANCE_LAN_ADDRESS=
TEAMAIBOX_WEB_TLS_DIRECTORY=
# Existing local office Worker identities; reuse on update, never regenerate.
LOCAL_OPENAI_WORKER_ID=
DRAWING_WORKER_ID=
OCR_WORKER_ID=
ASR_WORKER_ID=
TRANSLATION_WORKER_ID=
EMBEDDING_WORKER_ID=
# Host boot helper: exact local PostgreSQL container name, not a remote URL.
TEAMAIBOX_POSTGRES_CONTAINER=
# Internal Docker network for this appliance's existing Android browser bridge.
# Written to the installation's networks.env by appliance_setup/appliance_networks.
TEAMAIBOX_PHONE_CONTROL_NETWORK=
TEAMAIBOX_PLUGIN_INGRESS_NETWORK=
TEAMAIBOX_COMPUTE_INTERNAL_NETWORK=
# Comma-separated services explicitly retired by this installation's upgrade.
# Empty on a new installation. Only exited containers are omitted from health.
TEAMAIBOX_METRIC_RETIRED_CORE_SERVICES=
TEAMAIBOX_NODE_AGENT_IMAGE=
TEAMAIBOX_APPLIANCE_GATEWAY_IMAGE=
TEAMAIBOX_DOCKER_SOCKET_GID=
TEAMAIBOX_APPLIANCE_AGENT_IDENTITY_DIR=
TEAMAIBOX_APPLIANCE_PUBLIC_CONFIG_DIR=
TEAMAIBOX_NODE_INVENTORY_FILE=
TEAMAIBOX_NODE_AGENT_COMMAND_KEY_FILE=
TEAMAIBOX_APPLIANCE_SCHEDULER_KEY_FILE=
TEAMAIBOX_APPLIANCE_GATEWAY_TLS_KEY_FILE=
TEAMAIBOX_APPLIANCE_GATEWAY_SIGNING_KEY_FILE=
TEAMAIBOX_COMMAND_KEY_ID=scheduler-persistent-v1
TEAMAIBOX_ALLOWED_WORKER_PORTS=
# Optional root-owned legacy migration input; exact mounts remain plan-bound.
TEAMAIBOX_LEGACY_TRANSLATION_MODEL_ROOT=/srv/teamaibox/legacy/translation-models
TEAMAIBOX_APPLIANCE_IMAGE_DIGEST=
TEAMAIBOX_APPLIANCE_CONFIGURATION_DIGEST=
# Existing local guest pool/configuration; preserve these references on upgrade.
TEAMAIBOX_GUEST_CONFIG_DIR=
TEAMAIBOX_GUEST_DATA_ROOT=
TEAMAIBOX_GUEST_CONTROL_ROOT=
TEAMAIBOX_GUEST_MEDIA_ROOT=
TEAMAIBOX_GUEST_ASSETS_ROOT=
TEAMAIBOX_GUEST_RUNTIME_DIR=

# Product service images, runtime configuration, protected data and secrets.
TEAMAIBOX_AGENT_BRIDGE_IMAGE=
TEAMAIBOX_AGENT_MODEL_SIGNING_KEY_FILE=
TEAMAIBOX_APPLIANCE_CREDENTIAL_PEPPER_FILE=
TEAMAIBOX_APPLIANCE_OWNER_BOOTSTRAP_FILE=
TEAMAIBOX_APPLIANCE_OWNER_RECOVERY_KEY_FILE=
TEAMAIBOX_APPLIANCE_RESTART_POLICY_DIGEST=
TEAMAIBOX_APPLIANCE_RESTART_POLICY_FILE=
TEAMAIBOX_APPLIANCE_RESTART_POLICY_SEMANTIC_DIGEST=
TEAMAIBOX_APPLIANCE_RUNTIME_ENV_FILE=
TEAMAIBOX_ASR_PLUGIN_IMAGE=
TEAMAIBOX_BACKUP_CONTROL_VOLUME=
TEAMAIBOX_COMPUTE_GATEWAY_IMAGE=
TEAMAIBOX_DATA_ROOT=
TEAMAIBOX_DRAWING_PLUGIN_IMAGE=
TEAMAIBOX_EVENT_BUS_IMAGE=
TEAMAIBOX_EXCLUSIVE_DRAIN_TARGETS_DIGEST=
TEAMAIBOX_EXCLUSIVE_DRAIN_TARGETS_FILE=
TEAMAIBOX_MAINTENANCE_CONTROLLER_IMAGE=
TEAMAIBOX_MAINTENANCE_RUNTIME_CONFIG_FILE=
TEAMAIBOX_MAINTENANCE_SIGNING_KEY_ID=
TEAMAIBOX_MAINTENANCE_TLS_KEY_FILE=
TEAMAIBOX_MESSAGING_IMAGE=
TEAMAIBOX_MESSAGING_PLUGIN_IMAGE=
TEAMAIBOX_NATS_TOKEN_FILE=
TEAMAIBOX_OBJECT_KEK_FILE=
TEAMAIBOX_OBJECT_REFERENCE_KEY_FILE=
TEAMAIBOX_OBJECT_RPC_TOKEN_FILE=
TEAMAIBOX_OBJECT_SERVICE_IMAGE=
TEAMAIBOX_OBSERVABILITY_IMAGE=
TEAMAIBOX_OCR_PLUGIN_IMAGE=
TEAMAIBOX_PLATFORM_API_IMAGE=
TEAMAIBOX_PLATFORM_AUDIT_SIGNING_KEY_FILE=
TEAMAIBOX_PLATFORM_CONFIGURATION_DIGEST=
TEAMAIBOX_PLATFORM_PROVIDER_SECRET_MASTER_KEY_FILE=
TEAMAIBOX_PLUGIN_RUNTIME_IMAGE=
TEAMAIBOX_POSTGRES_IMAGE=
TEAMAIBOX_POSTGRES_PASSWORD_FILE=
TEAMAIBOX_PROTECTED_OFFICE_MAINTENANCE_KEY_FILE=
TEAMAIBOX_PROTECTED_SET_QUALIFICATION_POLICY_DIGEST=
TEAMAIBOX_PROTECTED_SET_QUALIFICATION_POLICY_FILE=
TEAMAIBOX_RELEASE_ID=
TEAMAIBOX_SCHEDULER_IMAGE=
TEAMAIBOX_SOURCE_GATEWAY_IMAGE=
TEAMAIBOX_TEAM_DRIVE_PLUGIN_IMAGE=
TEAMAIBOX_TRANSLATION_PLUGIN_IMAGE=
TEAMAIBOX_VIRTUAL_COMPUTERS_PLUGIN_IMAGE=
TEAMAIBOX_VIRTUAL_PHONES_PLUGIN_IMAGE=
TEAMAIBOX_WEB_IMAGE=
# Stable internal canonical HTTPS origin; not changed on DHCP renewals.
TEAMAIBOX_WEB_PUBLIC_ORIGIN=https://teamaibox.local
TEAMAIBOX_WEB_TLS_CERTIFICATE_FILE=
TEAMAIBOX_WEB_TLS_PRIVATE_KEY_FILE=
TEAMAIBOX_WIRELESS_CASTING_PLUGIN_IMAGE=
