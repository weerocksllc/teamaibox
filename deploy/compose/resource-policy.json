{
  "schemaVersion": 1,
  "resourceClasses": {
    "core-critical": {
      "description": "Fact stores, trusted API, object protection, messaging, and node control that must survive AI saturation.",
      "services": [
        "postgres",
        "event-bus",
        "platform-api",
        "node-agent",
        "object-service",
        "messaging"
      ]
    },
    "core-standard": {
      "description": "Restartable platform services that retain admission priority over AI workers.",
      "services": [
        "web",
        "scheduler",
        "plugin-runtime",
        "agent-bridge",
        "compute-gateway",
        "source-gateway",
        "observability"
      ]
    }
