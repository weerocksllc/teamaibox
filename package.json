{
  "name": "teamaibox",
  "version": "0.1.0",
  "private": true,
  "description": "Team AI Box appliance platform",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.1.0 <12"
  },
  "scripts": {
    "check:layout": "python3 tools/validate_module_layout.py",
    "test": "pnpm test:node && pnpm test:foundation",
    "test:foundation": "python3 -m unittest discover -s tests -v",
    "test:node": "node --test packages/*/test/*.test.mjs apps/*/test/*.test.mjs services/*/test/*.test.mjs"
  },
  "license": "MIT"
}
