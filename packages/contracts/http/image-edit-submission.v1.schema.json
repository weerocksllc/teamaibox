{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamaibox.local/http/image-edit-submission.v1.schema.json",
  "x-teamaibox-contract": {"family": "http", "role": "request", "major": 1},
  "title": "Queued image edit submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "input"],
  "properties": {
    "model": {"type": "string", "minLength": 1, "maxLength": 512},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 32000},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id"],
      "properties": {"reference_id": {"type": "string", "format": "uuid"}}
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id"],
      "properties": {"reference_id": {"type": "string", "format": "uuid"}}
    },
    "n": {"type": "integer", "minimum": 1, "maximum": 4, "default": 1},
    "size": {"enum": ["512x512", "768x768", "1024x1024", "1024x768", "768x1024"], "default": "1024x1024"},
    "preset_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$", "default": "drawing.balanced.v1"},
    "seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295},
    "strength": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.65},
    "steps": {"type": ["integer", "null"], "minimum": 1, "maximum": 200},
    "guidance_scale": {"type": ["number", "null"], "minimum": 0, "maximum": 50},
    "negative_prompt": {"type": ["string", "null"], "maxLength": 32000},
    "output_format": {"enum": ["png", "jpeg", "webp"], "default": "png"},
    "x_teamaibox": {"$ref": "../openai/request-extension.v1.schema.json"}
  }
}
