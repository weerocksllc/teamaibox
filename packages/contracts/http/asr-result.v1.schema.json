{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamaibox.local/http/asr-result.v1.schema.json",
  "x-teamaibox-contract": {"family": "http", "role": "response", "major": 1},
  "title": "Speech transcription result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "text", "language", "duration_seconds", "segments", "speaker_information", "artifacts", "provenance"],
  "properties": {
    "schema": {"const": "teamaibox.ai.asr-result.v1"},
    "job_id": {"type": "string", "format": "uuid"},
    "text": {"type": "string"},
    "language": {"type": "object", "additionalProperties": false, "required": ["code", "confidence"], "properties": {"code": {"type": "string"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "duration_seconds": {"type": "number", "minimum": 0},
    "segments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "start_seconds", "end_seconds", "text", "speaker", "confidence"], "properties": {
      "id": {"type": "string", "minLength": 1, "maxLength": 128},
      "start_seconds": {"type": "number", "minimum": 0},
      "end_seconds": {"type": "number", "minimum": 0},
      "text": {"type": "string"},
      "speaker": {"type": ["string", "null"], "maxLength": 128},
      "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
      "words": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["word", "start_seconds", "end_seconds", "confidence"], "properties": {"word": {"type": "string"}, "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "minimum": 0}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}},
      "provenance": {"type": "object", "additionalProperties": false, "required": ["shard_id", "shard_index", "source_segment_id", "source_result_artifact_id", "source_result_sha256", "source_start_seconds", "source_end_seconds", "source_speaker", "speaker_fingerprint"], "properties": {
        "shard_id": {"type": "string", "format": "uuid"},
        "shard_index": {"type": "integer", "minimum": 0},
        "source_segment_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_result_artifact_id": {"type": "string", "format": "uuid"},
        "source_result_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "source_start_seconds": {"type": "number", "minimum": 0},
        "source_end_seconds": {"type": "number", "minimum": 0},
        "source_speaker": {"type": ["string", "null"], "maxLength": 128},
        "speaker_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
      }}
    }}},
    "speaker_information": {"type": "object", "additionalProperties": false, "required": ["supported", "speaker_count"], "properties": {"supported": {"type": "boolean"}, "speaker_count": {"type": ["integer", "null"], "minimum": 0}}},
    "artifacts": {"type": "array", "items": {"$ref": "../compute/artifact-ref.v1.schema.json"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_reference_id", "profile_key", "profile_fingerprint", "engine_image_digest", "completed_at"], "properties": {
      "source_reference_id": {"type": "string", "format": "uuid"},
      "profile_key": {"type": "string"},
      "profile_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
      "engine_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
      "completed_at": {"type": "string", "format": "date-time"},
      "shard_plan": {"type": "object", "additionalProperties": false, "required": ["reducer_version", "plan_digest", "shard_count", "overlap_seconds", "shards"], "properties": {
        "reducer_version": {"const": "core-window-v1"},
        "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "shard_count": {"type": "integer", "minimum": 1, "maximum": 10080},
        "overlap_seconds": {"type": "number", "minimum": 0, "maximum": 120},
        "shards": {"type": "array", "minItems": 1, "maxItems": 10080, "items": {"type": "object", "additionalProperties": false, "required": ["shard_id", "shard_index", "core_start_seconds", "core_end_seconds", "media_start_seconds", "media_end_seconds", "result_artifact_id", "result_sha256"], "properties": {
          "shard_id": {"type": "string", "format": "uuid"},
          "shard_index": {"type": "integer", "minimum": 0},
          "core_start_seconds": {"type": "number", "minimum": 0},
          "core_end_seconds": {"type": "number", "minimum": 0},
          "media_start_seconds": {"type": "number", "minimum": 0},
          "media_end_seconds": {"type": "number", "minimum": 0},
          "result_artifact_id": {"type": "string", "format": "uuid"},
          "result_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }}}
      }}
    }}
  }
}
