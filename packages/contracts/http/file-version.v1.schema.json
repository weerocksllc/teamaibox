{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamaibox.local/http/file-version.v1.schema.json",
  "title": "Team Drive immutable file version v1",
  "x-teamaibox-contract": {"family": "http", "role": "response", "major": 1},
  "type": "object",
  "additionalProperties": false,
  "required": ["file_id", "object", "version", "object_id", "object_version", "byte_size", "media_type", "sha256", "provenance", "created_by_identity_id", "created_at"],
  "properties": {
    "file_id": {"type": "string", "format": "uuid"},
    "object": {"const": "files.version"},
    "version": {"type": "integer", "minimum": 1},
    "object_id": {"type": "string", "format": "uuid"},
    "object_version": {"type": "integer", "minimum": 1},
    "byte_size": {"type": "integer", "minimum": 1},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "provenance": {"type": "object", "additionalProperties": true},
    "created_by_identity_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
