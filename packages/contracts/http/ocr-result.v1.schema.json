{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamaibox.local/http/ocr-result.v1.schema.json",
  "title": "Team AI Box OCR result v1",
  "x-teamaibox-contract": {"family": "http", "role": "response", "major": 1},
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "text", "pages", "artifacts"],
  "properties": {
    "schema": {"const": "teamaibox.ai.ocr-result.v1"},
    "job_id": {"type": "string", "format": "uuid"},
    "text": {"type": "string"},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "width", "height", "blocks"],
        "properties": {
          "page_number": {"type": "integer", "minimum": 1},
          "width": {"type": "number", "exclusiveMinimum": 0},
          "height": {"type": "number", "exclusiveMinimum": 0},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "bounding_box", "confidence"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 128},
                "text": {"type": "string"},
                "bounding_box": {"type": "array", "minItems": 4, "maxItems": 8, "items": {"type": "number"}},
                "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "language": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "../compute/artifact-ref.v1.schema.json"}},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
