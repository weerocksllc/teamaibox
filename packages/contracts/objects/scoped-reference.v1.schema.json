{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamaibox.local/objects/scoped-reference.v1.schema.json",
  "title": "Team AI Box scoped object reference v1",
  "x-teamaibox-contract": {"family": "object", "role": "bidirectional", "major": 1},
  "type": "object",
  "additionalProperties": false,
  "required": ["referenceVersion", "referenceId", "objectId", "objectVersion", "audience", "operations", "expiresAt", "integrity"],
  "properties": {
    "referenceVersion": {"const": 1},
    "referenceId": {"type": "string", "format": "uuid"},
    "objectId": {"type": "string", "format": "uuid"},
    "objectVersion": {"type": "integer", "minimum": 1},
    "audience": {"type": "string", "pattern": "^[a-z][a-z0-9:._-]{2,190}$"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["head", "read", "range", "write-part", "complete"]}
    },
    "expiresAt": {"type": "string", "format": "date-time"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
