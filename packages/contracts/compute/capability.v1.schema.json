{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamaibox.local/compute/capability.v1.schema.json",
  "title": "Team AI Box logical capability v1",
  "x-teamaibox-contract": {
    "family": "compute",
    "role": "response",
    "major": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "capabilityKey",
    "modality",
    "contractVersion",
    "operations",
    "lifecycleState",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capabilityId": {
      "type": "string",
      "format": "uuid"
    },
    "capabilityKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "modality": {
      "type": "string",
      "enum": [
        "chat",
        "embedding",
        "image",
        "ocr",
        "asr",
        "translation",
        "codec",
        "realtime",
        "agent"
      ]
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^v[0-9]+([a-z][0-9]+)?$"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "chat.completions",
          "responses",
          "embeddings",
          "images.generations",
          "images.edits",
          "ocr",
          "audio.transcriptions",
          "translations",
          "codecs.transcode",
          "realtime.sessions",
          "agent.sessions"
        ]
      }
    },
    "inputDataClasses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ]
      }
    },
    "outputKinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "text",
          "embedding",
          "image",
          "document",
          "audio",
          "video",
          "artifact",
          "event_stream"
        ]
      }
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "retired"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
