{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.teamaibox.local/node-agent/node-inventory.v1.schema.json",
  "title": "Team AI Box managed node inventory v1",
  "x-teamaibox-contract": { "family": "node-agent", "role": "request", "major": 1 },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "architecture", "agentVersion", "health", "runtimes", "modelProfiles", "capabilities", "resources", "schedulerFacts", "networkLinks", "reservations", "activeWorkloads"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "architecture": { "const": "arm64" },
    "agentVersion": { "$ref": "#/$defs/version" },
    "health": {
      "type": "object", "additionalProperties": false, "required": ["state", "errorCode"],
      "properties": { "state": { "enum": ["healthy", "degraded"] }, "errorCode": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 } }
    },
    "runtimes": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "type": "object", "additionalProperties": false, "required": ["runtimeKey", "version", "imageDigest"], "properties": { "runtimeKey": { "$ref": "#/$defs/key" }, "version": { "$ref": "#/$defs/version" }, "imageDigest": { "$ref": "#/$defs/sha256" } } }
    },
    "modelProfiles": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": { "type": "object", "additionalProperties": false, "required": ["profileId", "profileKey", "profileFingerprint", "lifecycleState", "operations"], "properties": { "profileId": { "$ref": "#/$defs/uuid" }, "profileKey": { "$ref": "#/$defs/key" }, "profileFingerprint": { "$ref": "#/$defs/sha256" }, "lifecycleState": { "enum": ["certified", "experimental", "revalidation_required"] }, "operations": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } } } }
    },
    "capabilities": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": { "type": "object", "additionalProperties": false, "required": ["capabilityKey", "state", "evidenceDigest"], "properties": { "capabilityKey": { "$ref": "#/$defs/key" }, "state": { "enum": ["available", "degraded", "unavailable"] }, "evidenceDigest": { "$ref": "#/$defs/sha256" } } }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["cpu", "unifiedMemory", "accelerator", "codecs", "storage", "network"],
      "properties": {
        "cpu": { "$ref": "#/$defs/cpu" },
        "unifiedMemory": { "$ref": "#/$defs/unifiedMemory" },
        "accelerator": { "$ref": "#/$defs/accelerator" },
        "codecs": { "$ref": "#/$defs/codecs" },
        "storage": { "$ref": "#/$defs/storage" },
        "network": { "$ref": "#/$defs/network" }
      }
    },
    "schedulerFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["accelerator", "codec", "storage", "workerState", "modelArtifactCached", "inputArtifactIds"],
      "properties": {
        "accelerator": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "computeCapability", "supportedPrecisions", "evidenceDigest"],
          "properties": {
            "kind": { "$ref": "#/$defs/key" },
            "computeCapability": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
            "supportedPrecisions": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" } },
            "evidenceDigest": { "$ref": "#/$defs/sha256" }
          }
        },
        "codec": {
          "type": "object", "additionalProperties": false,
          "required": ["encodeSessions", "decodeSessions", "evidenceDigest"],
          "properties": { "encodeSessions": { "$ref": "#/$defs/nonnegative" }, "decodeSessions": { "$ref": "#/$defs/nonnegative" }, "evidenceDigest": { "$ref": "#/$defs/sha256" } }
        },
        "storage": {
          "type": "object", "additionalProperties": false,
          "required": ["classes", "evidenceDigest"],
          "properties": { "classes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }, "evidenceDigest": { "$ref": "#/$defs/sha256" } }
        },
        "workerState": { "enum": ["warm", "preparing", "cold"] },
        "modelArtifactCached": { "type": "boolean" },
        "inputArtifactIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" } }
      }
    },
    "networkLinks": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": { "type": "object", "additionalProperties": false, "required": ["linkKey", "networkClass", "health", "speedBitsPerSecond", "mtu", "latencyMicroseconds"], "properties": { "linkKey": { "$ref": "#/$defs/key" }, "networkClass": { "enum": ["management", "10gbe", "connectx-roce"] }, "health": { "enum": ["healthy", "degraded", "down"] }, "speedBitsPerSecond": { "$ref": "#/$defs/nonnegative" }, "mtu": { "type": "integer", "minimum": 1280, "maximum": 65535 }, "latencyMicroseconds": { "$ref": "#/$defs/nonnegative" } } }
    },
    "reservations": { "$ref": "#/$defs/reservations" },
    "activeWorkloads": { "type": "integer", "minimum": 0, "maximum": 100000 }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonnegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "resourceMap": { "type": "object", "maxProperties": 32, "patternProperties": { "^[a-z][A-Za-z0-9]{1,63}$": { "$ref": "#/$defs/nonnegative" } }, "additionalProperties": false },
    "reservations": { "allOf": [{ "$ref": "#/$defs/resourceMap" }], "required": ["cpuMillis", "unifiedMemoryBytes", "acceleratorUnits", "codecSessions", "storageBytes", "networkBitsPerSecond"] },
    "cpu": { "allOf": [{ "$ref": "#/$defs/resourceMap" }], "required": ["totalMillis", "availableMillis"] },
    "unifiedMemory": { "allOf": [{ "$ref": "#/$defs/resourceMap" }], "required": ["totalBytes", "availableBytes"] },
    "accelerator": { "allOf": [{ "$ref": "#/$defs/resourceMap" }], "required": ["units"] },
    "codecs": { "allOf": [{ "$ref": "#/$defs/resourceMap" }], "required": ["sessions"] },
    "storage": { "allOf": [{ "$ref": "#/$defs/resourceMap" }], "required": ["availableBytes"] },
    "network": { "allOf": [{ "$ref": "#/$defs/resourceMap" }], "required": ["availableBitsPerSecond"] }
  }
}
