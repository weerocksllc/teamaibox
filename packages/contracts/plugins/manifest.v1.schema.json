{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamaibox.local/plugins/manifest.v1.schema.json",
  "title": "Team AI Box signed plugin manifest v1",
  "x-teamaibox-contract": {"family": "plugin", "role": "request", "major": 1},
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "type",
    "version",
    "official",
    "publisher",
    "architectures",
    "images",
    "entryPoints",
    "apis",
    "ui",
    "localization",
    "themes",
    "permissions",
    "resources",
    "health",
    "migrations",
    "compatibility",
    "signature"
  ],
  "properties": {
    "apiVersion": {"const": "teamaibox.io/plugin/v1"},
    "id": {"$ref": "#/$defs/pluginId"},
    "type": {"type": "string", "enum": ["ApplicationPlugin", "ComputePlugin"]},
    "version": {"$ref": "#/$defs/semver"},
    "official": {"type": "boolean"},
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": {"$ref": "#/$defs/pluginId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
        "website": {"type": "string", "format": "uri", "maxLength": 2048}
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["linux/arm64/v8"]}
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "variants"],
        "properties": {
          "name": {"$ref": "#/$defs/safeName"},
          "role": {
            "type": "string",
            "enum": ["application", "worker", "migration", "sidecar"]
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["architecture", "reference", "digest", "mediaType"],
              "properties": {
                "architecture": {"type": "string", "enum": ["linux/arm64/v8"]},
                "reference": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 512,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]+$"
                },
                "digest": {"$ref": "#/$defs/sha256"},
                "mediaType": {"const": "application/vnd.oci.image.manifest.v1+json"}
              }
            }
          }
        }
      }
    },
    "entryPoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "integration"],
          "properties": {
            "path": {"$ref": "#/$defs/httpPath"},
            "integration": {"type": "string", "enum": ["iframe", "module"]}
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "capabilityRegistration"],
          "properties": {
            "protocol": {"const": "teamaibox.worker-control/v1"},
            "capabilityRegistration": {"const": "scheduler-only"}
          }
        }
      }
    },
    "apis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "versionRange", "access"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
          "versionRange": {"$ref": "#/$defs/versionRange"},
          "access": {"type": "string", "enum": ["delegated-user", "scheduler"]}
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayNameKey", "summaryKey", "icon", "category"],
      "properties": {
        "displayNameKey": {"$ref": "#/$defs/localeKey"},
        "summaryKey": {"$ref": "#/$defs/localeKey"},
        "icon": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "category": {
          "type": "string",
          "enum": ["collaboration", "ai-application", "professional-tool", "infrastructure"]
        },
        "launchPath": {"$ref": "#/$defs/httpPath"},
        "order": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedLocales", "fallbackLocale", "supportedDirections", "rtlReady"],
      "properties": {
        "supportedLocales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/locale"}
        },
        "fallbackLocale": {"$ref": "#/$defs/locale"},
        "supportedDirections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["ltr", "rtl"]}
        },
        "rtlReady": {"type": "boolean"}
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "usesSemanticTokens", "livePreferenceEvents"],
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["light", "dark"]}
        },
        "usesSemanticTokens": {"type": "boolean"},
        "livePreferenceEvents": {"type": "boolean"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformApiScopes", "delegatedUserToken", "network", "objectNamespaces", "devices"],
      "properties": {
        "platformApiScopes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9:._-]{2,127}$"}
        },
        "delegatedUserToken": {"type": "boolean"},
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "egressHosts"],
          "properties": {
            "mode": {"type": "string", "enum": ["none", "allowlist"]},
            "egressHosts": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-zA-Z0-9*][a-zA-Z0-9.*-]{0,252}$"}
            }
          }
        },
        "objectNamespaces": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}
        },
        "devices": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["accelerator", "video-codec", "audio"]}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "unifiedMemoryBytes", "ephemeralStorageBytes", "persistentStorageBytes", "network"],
      "properties": {
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestMillicores", "limitMillicores"],
          "properties": {
            "requestMillicores": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "limitMillicores": {"type": "integer", "minimum": 1, "maximum": 1000000}
          }
        },
        "unifiedMemoryBytes": {"type": "integer", "minimum": 16777216},
        "ephemeralStorageBytes": {"type": "integer", "minimum": 0},
        "persistentStorageBytes": {"type": "integer", "minimum": 0},
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ingressBitsPerSecond", "egressBitsPerSecond"],
          "properties": {
            "ingressBitsPerSecond": {"type": "integer", "minimum": 0},
            "egressBitsPerSecond": {"type": "integer", "minimum": 0}
          }
        },
        "accelerator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "units"],
          "properties": {
            "kind": {"type": "string", "enum": ["nvidia-gpu", "nvidia-video-codec"]},
            "units": {"type": "number", "exclusiveMinimum": 0, "maximum": 128}
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": {"$ref": "#/$defs/probe"},
        "readiness": {"$ref": "#/$defs/probe"},
        "liveness": {"$ref": "#/$defs/probe"}
      }
    },
    "migrations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fromVersion", "toVersion", "imageName", "transactional", "reversible"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{6}_[a-z][a-z0-9_]{2,63}$"},
          "fromVersion": {"$ref": "#/$defs/semver"},
          "toVersion": {"$ref": "#/$defs/semver"},
          "imageName": {"$ref": "#/$defs/safeName"},
          "transactional": {"type": "boolean"},
          "reversible": {"type": "boolean"}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "pluginApi", "runtime", "requiredCapabilities", "dependencies"],
      "properties": {
        "platform": {"$ref": "#/$defs/versionRange"},
        "pluginApi": {"$ref": "#/$defs/versionRange"},
        "runtime": {"type": "string", "enum": ["oci-linux-arm64-v1"]},
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pluginId", "versionRange", "optional"],
            "properties": {
              "pluginId": {"$ref": "#/$defs/pluginId"},
              "versionRange": {"$ref": "#/$defs/versionRange"},
              "optional": {"type": "boolean"}
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "algorithm", "keyId", "payloadDigest", "value"],
      "properties": {
        "format": {"const": "teamaibox.canonical-json/v1"},
        "algorithm": {"const": "Ed25519"},
        "keyId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}/[a-zA-Z0-9._:-]{1,128}$"},
        "payloadDigest": {"$ref": "#/$defs/sha256"},
        "value": {"type": "string", "minLength": 86, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{86}={0,2}$"}
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "oneOf": [
    {
      "properties": {
        "type": {"const": "ApplicationPlugin"},
        "entryPoints": {"required": ["web"], "properties": {"worker": false}},
        "ui": {"required": ["launchPath"]}
      }
    },
    {
      "properties": {
        "type": {"const": "ComputePlugin"},
        "entryPoints": {"required": ["worker"], "properties": {"web": false}}
      }
    }
  ],
  "$defs": {
    "pluginId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "safeName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
    "versionRange": {
      "type": "string",
      "pattern": "^(?:[><=~^]{1,2}[0-9]+\\.[0-9]+\\.[0-9]+)(?: (?:[><=~^]{1,2}[0-9]+\\.[0-9]+\\.[0-9]+))*$",
      "maxLength": 128
    },
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "httpPath": {"type": "string", "pattern": "^/[a-zA-Z0-9][a-zA-Z0-9/_.-]{0,254}$"},
    "locale": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$"},
    "localeKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}(?:\\.[a-z][a-z0-9-]{1,63})+$"},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "intervalSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "path": {"$ref": "#/$defs/httpPath"},
        "intervalSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "failureThreshold": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    }
  }
}
